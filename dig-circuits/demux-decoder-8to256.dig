    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>36</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>This module acts as the OneHotDecoder8 from the emulator code. It interprets the 8-bit hash value and converts it into a single active 
line out of 256. As Digital allows only up to 64 bits per splitter/merger input/output pin, I had to divide the 256 bit output into 4 
outputs, each merged by a 64 bit merger. In Minecraft, this will be more cleanly implemented as an 8to256 mux directly
outputting a 1 bit signal for the selected address.</string>
        </entry>
      </elementAttributes>
      <pos x="-4600" y="-220"/>
    </visualElement>
