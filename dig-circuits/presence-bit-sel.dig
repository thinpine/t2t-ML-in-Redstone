          <int>40</int>
        </entry>
        <entry>
          <string>RectHeight</string>
          <int>93</int>
        </entry>
        <entry>
          <string>Label</string>
          <string>Presence Bit Selector Network</string>
        </entry>
        <entry>
          <string>RectWidth</string>
          <int>129</int>
        </entry>
      </elementAttributes>
      <pos x="-160" y="-540"/>
    </visualElement>
