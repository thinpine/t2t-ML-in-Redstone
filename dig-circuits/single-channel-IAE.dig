    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>14</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>This embedded circuit processes a single class score. It uses an 8-bit AND gate to pass or block incoming signed weights based on feature activity. A sign-extension unit expands valid 8-bit weights to 17 bits 
to prevent math overflow. Finally, a 17-bit ripple-carry adder continuously sums these values into a clocked D-flip-flop register.</string>
        </entry>
      </elementAttributes>
      <pos x="-320" y="-280"/>
    </visualElement>
    <visualElement>
