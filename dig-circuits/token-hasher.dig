          <string>textFontSize</string>
          <int>20</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>This module executes a cyclical shift-XOR algorithm &quot;h_t = ROL_1(h_t-_1) XOR char-code&quot; to map incoming variable-length words 
into unique, repeatable 8-bit numerical keys. When a word completes, it holds this calculated address completely stable for 
downstream memory logging before resetting itself for the next word.</string>
        </entry>
      </elementAttributes>
      <pos x="60" y="-100"/>
    </visualElement>
