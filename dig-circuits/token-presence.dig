    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>Had to be implemented at the 64 bit scale instead of the planned 256 due to 
Digital allowing only up to 64 bit merger outputs.</string>
        </entry>
      </elementAttributes>
      <pos x="-340" y="80"/>
    </visualElement>
