        <entry>
          <string>RectHeight</string>
          <int>51</int>
        </entry>
        <entry>
          <string>Label</string>
          <string>Feature Mapping Decoder &amp; Presence Latches</string>
        </entry>
        <entry>
          <string>RectWidth</string>
          <int>84</int>
        </entry>
      </elementAttributes>
      <pos x="-360" y="40"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>This component maps input tokens to sentence memory. An 8-bit word slot address 
is continuously decoded into a one-hot representation, which is clocked into four 
parallel 64-bit sticky registers using the word-flush signal. Dedicated unclocked RS 
flip-flops capture structural punctuation flags instantly, maintaining a stable presence 
vector for analysis.</string>
        </entry>
      </elementAttributes>
      <pos x="260" y="880"/>
    </visualElement>
