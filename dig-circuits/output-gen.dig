      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>print-enable</string>
        </entry>
      </elementAttributes>
      <pos x="140" y="300"/>
    </visualElement>
    <visualElement>
      <elementName>Clock</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>stream-clk</string>
        </entry>
      </elementAttributes>
      <pos x="140" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Rectangle</elementName>
      <elementAttributes>
        <entry>
          <string>RectHeight</string>
          <int>20</int>
        </entry>
        <entry>
          <string>Label</string>
          <string>Generative Output Logic &amp; Text ROM</string>
        </entry>
        <entry>
          <string>RectWidth</string>
          <int>67</int>
        </entry>
      </elementAttributes>
      <pos x="-60" y="0"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>14</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>This module translates classification indices into sequential text streams. A free-running 4-bit LFSR pseudo-randomly selects one of four response variants. When inference stabilizes,
 this variant is latched and concatenated with the 2-bit winning class index to form a high-level ROM block address. A synchronous 4-bit counter increments through the block, 
streaming 5-bit character codes sequentially to the external display.</string>
        </entry>
      </elementAttributes>
      <pos x="-40" y="20"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>Class 0 - Inform:
-&quot;noted&quot;
-&quot;i see&quot;
-&quot;understood&quot;
-&quot;boring&quot;

Class 1 - Question:
-&quot;good question&quot;
-&quot;let me think&quot;
-&quot;tell me more&quot;
-&quot;why ask me&quot;</string>
        </entry>
      </elementAttributes>
      <pos x="-640" y="40"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>Class 2 - Directive:
-&quot;i will try&quot;
-&quot;certainly&quot;
-&quot;on it&quot;
-&quot;no way&quot;

Class 3 - Commissive:
-&quot;agreed&quot;
-&quot;sounds good&quot;
-&quot;lets do it&quot;
-&quot;i refuse&quot;</string>
        </entry>
      </elementAttributes>
      <pos x="-380" y="40"/>
    </visualElement>
    <visualElement>
      <elementName>Rectangle</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>36</int>
        </entry>
        <entry>
          <string>Label</string>
          <string>HARDCODED RESPONSES</string>
        </entry>
        <entry>
          <string>RectHeight</string>
          <int>20</int>
        </entry>
        <entry>
          <string>RectWidth</string>
          <int>29</int>
        </entry>
      </elementAttributes>
      <pos x="-680" y="0"/>
    </visualElement>
  </visualElements>
